# ============================================================================
# LEADS UI - ENVIRONMENT VARIABLES
# ============================================================================
# Frontend React application and Express backend configuration
# Copy this file to .env and fill in your actual values
# ============================================================================

# ============================================================================
# NODE / EXPRESS CONFIGURATION
# ============================================================================
# Environment mode
NODE_ENV=development

# Server port (Express backend)
PORT=5000

# React development server port
# PORT=3000  # Uncomment for React dev server

# ============================================================================
# GOOGLE SHEETS CONFIGURATION
# ============================================================================
# Path to service account JSON key
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json

# Google Sheet ID
SHEET_ID=your-google-sheet-id-here

# ============================================================================
# API CONFIGURATION
# ============================================================================
# API base URL (for frontend to call backend)
REACT_APP_API_URL=/api

# Full API URL (if backend is on different domain)
# REACT_APP_API_BASE_URL=https://api.easyfindprops.com

# ============================================================================
# FEATURE FLAGS (Frontend)
# ============================================================================
# Enable conversation view
REACT_APP_FEATURE_CONVERSATIONS=true

# Enable charts and analytics
REACT_APP_FEATURE_ANALYTICS=true

# Enable lead editing
REACT_APP_FEATURE_EDIT_LEADS=true

# Enable export functionality
REACT_APP_FEATURE_EXPORT=true

# ============================================================================
# UI CONFIGURATION
# ============================================================================
# Application title
REACT_APP_TITLE=EasyFind Lead Management

# Company name
REACT_APP_COMPANY_NAME=EasyFind Property Solutions

# Items per page (pagination)
REACT_APP_ITEMS_PER_PAGE=50

# Date format
REACT_APP_DATE_FORMAT=DD/MM/YYYY

# ============================================================================
# GOOGLE ANALYTICS (OPTIONAL)
# ============================================================================
# REACT_APP_GA_TRACKING_ID=G-XXXXXXXXXX

# ============================================================================
# SENTRY ERROR TRACKING (OPTIONAL)
# ============================================================================
# REACT_APP_SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# ============================================================================
# BUILD CONFIGURATION
# ============================================================================
# Generate sourcemaps in production
GENERATE_SOURCEMAP=false

# Build path
# BUILD_PATH=build

# Public URL (for deployment)
# PUBLIC_URL=https://leads.easyfindprops.com

# ============================================================================
# DEVELOPMENT SETTINGS
# ============================================================================
# Disable eslint warnings as errors
ESLINT_NO_DEV_ERRORS=true

# Disable type checking
# TSC_COMPILE_ON_ERROR=true

# Enable fast refresh
FAST_REFRESH=true

# ============================================================================
# NOTES
# ============================================================================
# 
# Frontend variables must be prefixed with REACT_APP_
# Backend variables use standard naming
# 
# For Render deployment, set these in the Render Dashboard
# under Environment → Environment Variables
#
# Required variables:
#   - GOOGLE_APPLICATION_CREDENTIALS
#   - SHEET_ID
#   - NODE_ENV (set to 'production' in production)
#
# ============================================================================
