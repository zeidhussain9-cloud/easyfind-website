# ============================================================================
# EASYFIND LEAD MANAGEMENT SYSTEM - ENVIRONMENT VARIABLES
# ============================================================================
# Copy this file to .env and fill in your actual values
# Never commit .env to version control!
# ============================================================================

# ============================================================================
# GOOGLE SHEETS CONFIGURATION (REQUIRED)
# ============================================================================
# Path to your Google service account JSON key file
GOOGLE_APPLICATION_CREDENTIALS=/path/to/your/service-account-key.json

# Google Sheet ID (from the URL)
# Example: https://docs.google.com/spreadsheets/d/SHEET_ID_HERE/edit
SHEET_ID=your-google-sheet-id-here

# ============================================================================
# AWS BEDROCK (OPTIONAL - for Claude AI classification)
# ============================================================================
# AWS region where Bedrock is available
AWS_REGION=us-east-1

# AWS credentials (optional if using ~/.aws/credentials or IAM roles)
# AWS_ACCESS_KEY_ID=your-access-key-here
# AWS_SECRET_ACCESS_KEY=your-secret-key-here
# AWS_SESSION_TOKEN=your-session-token-here  # Only if using temporary credentials

# Bedrock model ID
BEDROCK_MODEL=anthropic.claude-3-sonnet-20240229-v1:0

# ============================================================================
# GOOGLE GEMINI (OPTIONAL - alternative to Bedrock)
# ============================================================================
# Google Gemini API key
# Get from: https://makersuite.google.com/app/apikey
GOOGLE_API_KEY=your-gemini-api-key-here

# Gemini model version
GEMINI_MODEL=gemini-pro

# ============================================================================
# OPENAI (OPTIONAL - alternative AI provider)
# ============================================================================
# OpenAI API key
# OPENAI_API_KEY=sk-your-openai-key-here

# OpenAI model
# OPENAI_MODEL=gpt-4-turbo-preview

# ============================================================================
# ANTHROPIC (OPTIONAL - direct Claude API)
# ============================================================================
# Anthropic API key (for direct Claude API access, not Bedrock)
# ANTHROPIC_API_KEY=sk-ant-your-key-here

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
# SQLite database file path
DATABASE_PATH=./leads.db

# Database backup directory (optional)
# DATABASE_BACKUP_DIR=./backups

# ============================================================================
# APPLICATION SETTINGS
# ============================================================================
# Environment (development, staging, production)
NODE_ENV=development

# Application port for Express server
PORT=5000

# Frontend port (React dev server)
# REACT_APP_PORT=3000

# API base URL (for frontend)
API_BASE_URL=http://localhost:5000

# ============================================================================
# WHATSAPP EXTRACTION SETTINGS
# ============================================================================
# Default date range for extraction (days)
WHATSAPP_EXTRACTION_DAYS=60

# Default backup type
WHATSAPP_BACKUP_TYPE=android-crypt15

# Backup directory
WHATSAPP_BACKUP_DIR=./whatsapp_backups

# Output directory for extracted data
EXTRACTED_DATA_DIR=./extracted_data

# ============================================================================
# AI CLASSIFICATION SETTINGS
# ============================================================================
# Batch size for AI classification
CLASSIFICATION_BATCH_SIZE=10

# Delay between batches (seconds)
CLASSIFICATION_BATCH_DELAY=6

# Max retries for failed classifications
CLASSIFICATION_MAX_RETRIES=3

# Confidence threshold (0.0 to 1.0)
CLASSIFICATION_CONFIDENCE_THRESHOLD=0.7

# ============================================================================
# GOOGLE SHEETS SYNC SETTINGS
# ============================================================================
# Batch size for sheet updates
SHEETS_BATCH_SIZE=1000

# Sync interval (minutes) - for automated sync
# SHEETS_SYNC_INTERVAL=30

# ============================================================================
# LOGGING CONFIGURATION
# ============================================================================
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Log file path
LOG_FILE=./application.log

# Log format
# LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s

# ============================================================================
# SECURITY SETTINGS
# ============================================================================
# Secret key for sessions (generate a random string)
# SECRET_KEY=your-secret-key-here-change-this-in-production

# JWT secret (if implementing authentication)
# JWT_SECRET=your-jwt-secret-here

# CORS allowed origins (comma-separated)
# CORS_ORIGINS=http://localhost:3000,https://your-domain.com

# ============================================================================
# RENDER.COM DEPLOYMENT (OPTIONAL)
# ============================================================================
# Render API key (for deployments via API)
# RENDER_API_KEY=rnd_your-render-api-key

# Service ID
# RENDER_SERVICE_ID=srv-your-service-id

# ============================================================================
# MONITORING & ANALYTICS (OPTIONAL)
# ============================================================================
# Sentry DSN (error tracking)
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# Google Analytics ID
# GA_TRACKING_ID=G-XXXXXXXXXX

# ============================================================================
# RATE LIMITING
# ============================================================================
# Max requests per minute (for API)
# RATE_LIMIT_MAX_REQUESTS=100

# Rate limit window (minutes)
# RATE_LIMIT_WINDOW=1

# ============================================================================
# FEATURE FLAGS
# ============================================================================
# Enable/disable features
FEATURE_AI_CLASSIFICATION=true
FEATURE_AUTO_SYNC=false
FEATURE_SENTIMENT_ANALYSIS=true
FEATURE_AUTO_FOLLOWUP=false

# ============================================================================
# TIMEZONE
# ============================================================================
# Application timezone
TZ=Asia/Kolkata

# ============================================================================
# DEVELOPMENT SETTINGS
# ============================================================================
# Debug mode (set to false in production)
DEBUG=true

# Verbose logging
VERBOSE=false

# Mock AI responses (for testing without API calls)
# MOCK_AI=false

# ============================================================================
# NOTES
# ============================================================================
# 
# 1. Copy this file: cp .env.example .env
# 2. Fill in your actual values in .env
# 3. Never commit .env to Git
# 4. Use strong, random values for secrets
# 5. Update .env when adding new environment variables
# 6. Document any custom variables you add
#
# Required variables:
#   - GOOGLE_APPLICATION_CREDENTIALS
#   - SHEET_ID
#   - At least one AI provider (AWS, Gemini, or OpenAI)
#
# For production deployment:
#   - Set NODE_ENV=production
#   - Set DEBUG=false
#   - Use strong SECRET_KEY
#   - Configure proper CORS_ORIGINS
#   - Set up monitoring (Sentry)
#
# ============================================================================
